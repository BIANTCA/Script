local padsByZone = {}
local zoneNames = {}
for _, d in ipairs(workspace:GetDescendants()) do
 if d:IsA("BasePart") then
  local zone = d:GetAttribute("TrainingZone")
  if zone and d.Parent and d.Parent:FindFirstChild("Target") then
   if not padsByZone[zone] then
    padsByZone[zone] = {}
    table.insert(zoneNames, zone)
   end
   table.insert(padsByZone[zone], d)
  end
 end
end
table.sort(zoneNames)
if #zoneNames == 0 then zoneNames = {"None"} end

local selectedZone = zoneNames[1]
local autoTrain = false
local lastTry = 0

local function nearestPad(zone)
 local list = padsByZone[zone]
 local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
 if not list or not hrp then return nil end
 local best, bestDist = nil, math.huge
 for _, pad in ipairs(list) do
  if pad.Parent then
   local dist = (pad.Position - hrp.Position).Magnitude
   if dist < bestDist then best, bestDist = pad, dist end
  end
 end
 return best, bestDist
end

local function canTrain(zone)
 local ok, allowed, reason = pcall(function()
  local GameData = require(RS.Framework.Shared.GameData).Client
  local Zones = require(RS.Framework.Tables.TrainingZones).TrainingZones
  local Events = require(RS.Framework.Tables.AdminEvents)
  local z = Zones[zone]
  if not z then return false, "Unknown zone" end
  if z.Pass and not (GameData.Owns(z.Pass)
   or Events.FreesPass(GameData.ServerStore.AdminEvents.Get(), z.Pass)) then
   return false, "You don't own the " .. tostring(z.Pass) .. " pass"
  end
  if GameData.Rebirths.Get() < (z.RequiredRebirths or 0) then
   return false, "Requires " .. tostring(z.RequiredRebirths) .. " rebirths"
  end
  return true
 end)
 if not ok then return false, "Failed to check zone requirements" end
 return allowed, reason
end

local function trainOnce()
 local States = findModule("States", "AutoThrow")
 local Training = findModule("Training", "GetPadInfo")
 if not (States and Training) then
  Tumblr:Notify({Title = "Error", Content = "Training/States module not found", Duration = 3})
  return false
 end
 if States.IsTraining() then return true end

 local pad, dist = nearestPad(selectedZone)
 if not pad then
  Tumblr:Notify({Title = "Error", Content = "Zone pad not found", Duration = 3})
  return false
 end

 local allowed, reason = canTrain(selectedZone)
 if not allowed then
  Tumblr:Notify({Title = "Unavailable", Content = reason or "Zone is locked", Duration = 3})
  return false
 end

 local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
 if hrp and dist and dist > 30 then
  hrp.CFrame = CFrame.new(pad.Position + Vector3.new(0, 4, 0))
  task.wait(0.3)
 end

 States.TrainPad(pad)
 pcall(Training.Train, pad)
 return true
end

