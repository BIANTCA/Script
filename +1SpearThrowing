local function fmtNum(n)
 local units = {{1e12, "T"}, {1e9, "B"}, {1e6, "M"}, {1e3, "K"}}
 for _, u in ipairs(units) do
  if n >= u[1] then return string.format("%.4g%s", n / u[1], u[2]) end
 end
 return tostring(n)
end

local function eggStands()
 local byName, names = {}, {}
 local okEggs, EggsTable = pcall(function()
  return require(RS.Framework.Tables.Eggs).Eggs
 end)
 if not okEggs then EggsTable = {} end

 for _, stand in ipairs(CS:GetTagged("Egg")) do
  local name = stand:GetAttribute("Egg")
  local data = EggsTable[name]
  if name and stand:IsA("BasePart") and not (data and data.Product) then
   if not byName[name] then
    byName[name] = {}
    table.insert(names, name)
   end
   table.insert(byName[name], stand)
  end
 end

 table.sort(names, function(a, b)
  local oa = EggsTable[a] and EggsTable[a].Order or 99
  local ob = EggsTable[b] and EggsTable[b].Order or 99
  return oa < ob
 end)
 return byName, names, EggsTable
end

