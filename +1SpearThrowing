local moduleCache = {}

local function findModule(name, key)
 local cached = moduleCache[name]
 if cached then return cached end

 if not getloadedmodules then return nil end

 local list = getloadedmodules()

 for _, m in ipairs(list) do
  if m.Name == name then
   local ok, mod = pcall(require, m)
   if ok and type(mod) == "table" and (not key or mod[key] ~= nil) then
    moduleCache[name] = mod
    return mod
   end
  end
 end

 if key then
  for _, m in ipairs(list) do
   local ok, mod = pcall(require, m)
   if ok and type(mod) == "table" and mod[key] ~= nil then
    moduleCache[name] = mod
    return mod
   end
  end
 end
end

