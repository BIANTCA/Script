autoHatchToggle = MainTab:CreateToggle({
 Name = "Auto Hatch",
 Description = "Hatches eggs automatically (needs enough Wins and pet slots)",
 CurrentValue = false,
 Callback = function(v)
  local States = findModule("States", "AutoThrow")
  local Eggs = findModule("Eggs", "ToggleAuto")
  if not (States and Eggs) then
   Tumblr:Notify({Title = "Error", Content = "Eggs/States module not found", Duration = 3})
   return
  end

  if not v then
   States.AutoHatch(false)
   return
  end

  task.spawn(function()
   hatchStarting = true

   local byName = eggStands()
   local list = byName[selectedEgg]
   local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
   local stand, best = nil, math.huge
   if list and hrp then
    for _, s in ipairs(list) do
     local d = (s.Position - hrp.Position).Magnitude
     if d < best then stand, best = s, d end
    end
   end

   if not stand then
    Tumblr:Notify({Title = "Error", Content = "Egg stand not found", Duration = 3})
    hatchStarting = false
    autoHatchToggle.Set(false)
    return
   end

   if best > 8 then
    hrp.CFrame = CFrame.new(stand.Position + Vector3.new(0, 4, 0))
   end

   local t = tick()
   while not States.NearEgg() and tick() - t < 3 do task.wait(0.1) end

   if States.NearEgg() and not States.AutoHatch() then
    pcall(Eggs.ToggleAuto)
   end

   task.wait(0.3)
   hatchStarting = false
   if not States.AutoHatch() then
    Tumblr:Notify({Title = "Failed", Content = "Auto Hatch did not start (check Wins and pet slots)", Duration = 3})
    autoHatchToggle.Set(false)
   end
  end)
 end
})

