local AUTOWIN_POSITION = Vector3.new(3035.6, 7.7, -6019.0)
local AUTOWIN_OFFSET = Vector3.new(0, 3, 0)
local AUTOWIN_INTERVAL = 1.5

local savedCFrame = nil

local function teleportToAutoWin()
    local hrp = getHRP()
    if not hrp then return false end
    hrp.CFrame = CFrame.new(AUTOWIN_POSITION) + AUTOWIN_OFFSET
    return true
end

local function saveOriginalPosition()
    local hrp = getHRP()
    if hrp then
        savedCFrame = hrp.CFrame
    end
end

local function restoreOriginalPosition()
    if savedCFrame then
        local hrp = getHRP()
        if hrp then
            hrp.CFrame = savedCFrame
        end
        savedCFrame = nil
    end
end

