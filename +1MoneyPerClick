local function getHighestMoneyPad()
    local stageFolder = Workspace:FindFirstChild("Moneypad Stage")
    if not stageFolder then return nil, 0 end
    local listmodel = stageFolder:FindFirstChild("listmodel") or stageFolder

    local bestPart, bestNum = nil, 0
    for _, child in ipairs(listmodel:GetChildren()) do
        local num = tonumber(child.Name:match("MoneyPad(%d+)"))
        if num and num > bestNum then
            local part = child:IsA("BasePart") and child or child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart", true)
            if part then bestPart, bestNum = part, num end
        end
    end
    return bestPart, bestNum
end

local function teleportToHighestMoneyPad()
    local part, num = getHighestMoneyPad()
    if not part then return false, 0 end

    local hrp = getHRP()
    if not hrp then return false, num end

    hrp.CFrame = part.CFrame + Vector3.new(0, 5, 0)
    fireTouch(hrp, part)
    return true, num
end

