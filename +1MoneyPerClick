local function findRemote(names)
    local folders = {
        ReplicatedStorage,
        ReplicatedStorage:FindFirstChild("Events"),
        ReplicatedStorage:FindFirstChild("Remotes"),
    }
    for _, folder in ipairs(folders) do
        if folder then
            for _, n in ipairs(names) do
                local r = folder:FindFirstChild(n)
                if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then
                    return r
                end
            end
        end
    end
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local ln = obj.Name:lower()
            if ln:find("egg") and (ln:find("open") or ln:find("buy") or ln:find("hatch")) and not ln:find("can") and not ln:find("robux") then
                return obj
            end
        end
    end
    return CanOpenEggRemote
end

local OpenEggRemote = findRemote({"OpenEgg", "OpenEggRemote", "BuyEgg", "BuyEggRemote", "HatchEgg", "HatchEggRemote", "EggOpen"})

local function getValue(path)
    local obj = LocalPlayer
    for _, name in ipairs(path) do
        obj = obj:WaitForChild(name, 5)
        if not obj then return 0 end
    end
    return obj.Value or 0
end

