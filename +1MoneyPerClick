local function getSortedTrails()
    local sorted = {}
    for id, data in pairs(TrailData.Trails) do
        local numId = tonumber(id)
        if numId then table.insert(sorted, {id = numId, data = data}) end
    end
    table.sort(sorted, function(a, b) return a.id < b.id end)
    return sorted
end

local function isTrailBuyable(data)
    if data.RobuxOnly or data.RequiredPrestige then return false end
    if not data.WinsPrice or data.WinsPrice <= 0 then return false end
    return true
end

local function getNextBuyableTrail()
    local wins = getWins()
    for _, trail in ipairs(getSortedTrails()) do
        if isTrailBuyable(trail.data) and wins >= trail.data.WinsPrice then
            return trail.id, trail.data
        end
    end
    return nil, nil
end

local function getSortedEggs()
    local sorted = {}
    for name, data in pairs(EggsModule) do
        if type(data) == "table" then
            table.insert(sorted, {name = name, data = data})
        end
    end
    table.sort(sorted, function(a, b)
        return (a.data.EggCost or 0) < (b.data.EggCost or 0)
    end)
    return sorted
end

local function formatEggDetails(eggName)
    local data = EggsModule[eggName]
    if not data then return "Egg not found" end

    local lines = {}
    table.insert(lines, "Egg: " .. eggName)
    table.insert(lines, "Rarity: " .. tostring(data.Rarity or "Unknown"))

    if data.RobuxEgg then
        table.insert(lines, "Price: " .. tostring(data.RobuxPrice or "?") .. " Robux [ROBUX ONLY]")
    else
        local cost = data.EggCost or 0
        table.insert(lines, "Price: " .. GameConfig.AbbreviateNumber(cost) .. " Wins")
        -- Hanya indikator visual, tidak memblokir pembelian
        table.insert(lines, "Visual Check: " .. (getWins() >= cost and "✅ Affordable" or "❌ Not Affordable (Force Buy Active)"))
    end

    table.insert(lines, "")
    table.insert(lines, "Drop Chances:")
    if data.RarityChances then
        for rarity, chance in pairs(data.RarityChances) do
            table.insert(lines, "  - " .. rarity .. ": " .. string.format("%.2f", chance * 100) .. "%")
        end
    end

    table.insert(lines, "")
    table.insert(lines, "Pets:")
    if data.PetRaritys then
        for rarity, pets in pairs(data.PetRaritys) do
            table.insert(lines, "  [" .. rarity .. "]")
            for _, petInfo in ipairs(pets) do
                table.insert(lines, "    - " .. tostring(petInfo[1]) .. " (Power: " .. GameConfig.AbbreviateNumber(petInfo[2] or 0) .. ")")
            end
        end
    end

    return table.concat(lines, "\n")
end

-- PEMBELIAN PAKSA: Pengecekan uang dihapus, biarkan server yang memvalidasi
local function tryOpenEgg(eggName, amount)
    local data = EggsModule[eggName]
    if not data then return false, "Egg data not found" end
    if data.RobuxEgg then return false, "Robux-only egg" end

    local openRemote = OpenEggRemote or CanOpenEggRemote
    if not openRemote then return false, "Remote not found" end

    local sent, err = pcall(function()
        if openRemote:IsA("RemoteFunction") then
            return openRemote:InvokeServer(eggName, amount)
        end
        openRemote:FireServer(eggName, amount)
        return true, "Request Sent"
    end)

    if not sent then return false, tostring(err) end
    return true, "Processed by Server"
end

