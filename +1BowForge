task.spawn(function()
	while running() do
		task.wait(1)
		if S.autoRebirth and not S.returning and canRebirthNow() then
			setState("Rebirth: mencoba rebirth")
			local before = (StateMod.profile.rebirths or 0)
			fireCmd("Rebirth")
			task.wait(3)
			local prof = StateMod.profile
			if prof and (prof.rebirths or 0) > before then
				notify("Rebirth", "Rebirth " .. prof.rebirths .. " berhasil, mulai dari Stage " .. S.stageStart)
				current = nil
				cancelTween()
				resetStage()
			else
				logf("Rebirth", "Rebirth gagal, coba lagi 5 detik", true)
				task.wait(5)
			end
		end
	end
end)

-- Main loop
task.spawn(function()
	local lastTween, lastHomeCheck = 0, 0
	local wasActive = false

	while running() do
		task.wait()

		local active = S.combat or S.collect
		if not active then
			cancelTween()
			current = nil
			wasActive = false
			setState("Idle (Auto Combat & Auto Collect mati)")
			continue
		end
		if not wasActive then
			wasActive = true
			logf("Main", "Loop aktif (combat=" .. tostring(S.combat) .. " collect=" .. tostring(S.collect) .. ")", true)
			resetStageTimers()
		end

		local hrp, hum = getHRP()
		if not (hrp and hum and hum.Health > 0) then
			current = nil
			setState("Menunggu karakter hidup")
			continue
		end

		if S.bagFull then
			current = nil
			returnToBase()
			resetStageTimers()
			continue
		end

		local now = os.clock()
		local handled = false

		-- Cek lokasi: di base/return (bukan di stage) -> mulai lagi dari stage awal
		if S.combat and stageIdx and not stageBroken
			and not needTravel and now - lastHomeCheck > 0.3 then
			lastHomeCheck = now
			if nearHome(hrp.Position) then
				local inst = findStage(stageIdx)
				local sp = inst and stagePos(inst)
				if not sp or (sp - hrp.Position).Magnitude > S.homeRadius then
					current = nil
					cancelTween()
					resetStage()
					notify("Stage", "Di base, mulai dari Stage " .. S.stageStart)
					continue
				end
			end
		end

		local stageActive = S.combat and not stageDone and not stageBroken

		-- [1] Auto Stage: init + travel ke stage (tween)
		if stageActive then
			if not stageIdx then
				stageIdx = math.clamp(S.stageStart, 1, 30)
				needTravel = true
				logf("Stage", "Mulai dari Stage " .. stageIdx, true)
			end
			if needTravel then
				needTravel = false
				current = nil
				if goStage(stageIdx, hrp) then
					resetStageTimers()
				else
					stageBroken = true
					setState(string.format("Error: Stage%02d tidak ditemukan", stageIdx))
					notify("Stage", string.format("Stage%02d tidak ditemukan di Workspace, Auto Stage dilewati", stageIdx))
				end
				continue
			end
		end

		-- Auto Collect efektif: stage di bawah Collect From Stage = hanya killing mob
		local collectOn = S.collect
		if collectOn and stageActive and stageIdx and stageIdx < S.collectFrom then
			collectOn = false
		end

		-- [2] Deteksi jumlah mob
		local mobsNow = nil
		if stageActive then
			mobsNow = aliveCount(hrp.Position)
			if mobsNow ~= mobCount then
				logf("Mob", "Jumlah mob: " .. mobCount .. " -> " .. mobsNow, true)
				mobCount = mobsNow
			end
			if mobsNow > 0 then
				seenMob = true
				if cleared then
					local pc = collectOn and pendingCount(hrp) or 0
					if pc == 0 then
						logf("Mob", "Mob kembali bertambah (" .. mobsNow .. ") & drop = 0, lanjut stage", true)
						advanceStage()
						continue
					end
				else
					emptySince = nil
					clearSince = nil
					lastCollectTP = now
				end
			elseif seenMob and not emptySince then
				emptySince = now
				logf("Mob", "Mob = 0, lanjut deteksi drop", true)
			end
		end

		-- Waktu idle sejak mob habis / teleport collect terakhir
		local idleElapsed = 0
		if stageActive and seenMob and emptySince then
			idleElapsed = now - math.max(emptySince, lastCollectTP)
		end

		-- [3] Auto Collect
		if collectOn and (mobsNow == nil or mobsNow == 0 or cleared) then
			local d, mode = nearestDrop(hrp)
			if d then
				current = nil
				if stageActive and seenMob and emptySince then
					cleared = true
				end
				if stageActive and seenMob and emptySince
					and now - math.max(emptySince, lastCollectTP) >= S.collectIdle then
					notify("Collect", "Tidak teleport " .. S.collectIdle .. " dtk, paksa lanjut stage")
					advanceStage()
				else
					collectDrop(d, mode, hrp)
				end
				handled = true
			end
		end

		-- [4] Keputusan stage
		if not handled and stageActive then
			if mobsNow > 0 then
				if cleared then
					setState(string.format("Stage clear, mob kembali (%d), menunggu Auto Collect", mobsNow))
				else
					setState(string.format("Killing mob di Stage%02d (mob: %d)", stageIdx, mobsNow))
				end
			elseif seenMob then
				if not cleared and emptySince and now - emptySince < S.clearDelay then
					setState("Mob = 0, mendeteksi drop")
				elseif not collectOn then
					-- Auto Collect dilewati / mati: tidak ada yang diambil, jangan menunggu selamanya
					if not cleared then
						cleared = true
						waitSince = now
						logf("Stage", "Mob = 0, Auto Collect dilewati (Stage" .. stageIdx .. " < " .. S.collectFrom .. "), menunggu mob kembali bertambah", true)
					end
					setState("Mob = 0, menunggu mob kembali bertambah")
					if idleElapsed >= S.collectIdle then
						notify("Stage", "Idle " .. S.collectIdle .. " dtk & Auto Collect dilewati, paksa lanjut stage")
						advanceStage()
						continue
					end
					if S.respawnTimeout > 0 and now - waitSince >= S.respawnTimeout then
						notify("Stage", "Mob tidak kembali " .. S.respawnTimeout .. " dtk, paksa lanjut stage")
						advanceStage()
						continue
					end
				else
					local pc = pendingCount(hrp)
					if pc > 0 then
						cleared = true
						clearSince = nil
						waitSince = now
						if idleElapsed >= S.collectIdle then
							notify("Collect", "Tidak teleport " .. S.collectIdle .. " dtk, paksa lanjut stage")
							advanceStage()
							continue
						end
						setState("Drop = " .. pc .. ", Auto Collect berjalan")
					elseif cleared then
						setState("Mob = 0, Drop = 0, menunggu mob kembali bertambah")
						if idleElapsed >= S.collectIdle then
							notify("Stage", "Drop = 0 & idle " .. S.collectIdle .. " dtk, paksa lanjut stage")
							advanceStage()
							continue
						end
						if S.respawnTimeout > 0 and now - waitSince >= S.respawnTimeout then
							notify("Stage", "Mob tidak kembali " .. S.respawnTimeout .. " dtk, paksa lanjut stage")
							advanceStage()
							continue
						end
					elseif now - (emptySince or now) < S.lootGrace then
						setState("Mob = 0, Drop = 0, menunggu drop muncul")
					else
						clearSince = clearSince or now
						if now - clearSince >= S.collectConfirm then
							cleared = true
							waitSince = now
							logf("Collect", "Drop = 0 terkonfirmasi, menunggu mob kembali bertambah", true)
							setState("Drop = 0 terkonfirmasi, menunggu mob kembali bertambah")
						else
							setState("Drop = 0, konfirmasi Auto Collect")
						end
					end
				end
			elseif now - enteredAt > S.startTimeout then
				local pc = collectOn and pendingCount(hrp) or 0
				if pc == 0 then
					emptyTries = emptyTries + 1
					logf("Stage", "Mob tidak muncul (percobaan " .. emptyTries .. "/2)", true)
					if emptyTries >= 2 then
						notify("Stage", "Stage " .. stageIdx .. " tidak ada mob, dilewati")
						advanceStage()
					else
						needTravel = true
					end
					continue
				end
			else
				setState("Menunggu mob muncul")
			end
		end

		-- [5] Combat: serang mob terdekat (tween bila jauh)
		if not handled and S.combat then
			if not targetValid(current) then
				current = listTargets(hrp.Position)[1]
				if current then
					local nm = (current.fallback and tostring(current.ref.Name))
						or (current.ref.def and tostring(current.ref.def.name or current.ref.def.id))
						or "mob"
					logf("Combat", "Target baru: " .. nm)
				end
			end

			if current then
				local pos = targetPos(current)
				local dir = Vector3.new(hrp.Position.X - pos.X, 0, hrp.Position.Z - pos.Z)
				if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, 1) end
				local flat = pos + dir.Unit * S.distance
				local stand = Vector3.new(flat.X, pos.Y + S.heightOffset, flat.Z)
				local look = Vector3.new(pos.X, stand.Y, pos.Z)

				if (hrp.Position - stand).Magnitude > 80 then
					if now - lastTween > 0.3 then
						lastTween = now
						tweenTo(CFrame.lookAt(stand, look), hrp)
					end
				else
					cancelTween()
					hrp.CFrame = CFrame.lookAt(stand, look)
					hrp.AssemblyLinearVelocity = Vector3.zero
				end
			else
				cancelTween()
			end
		end
	end
end)

