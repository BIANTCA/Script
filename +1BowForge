	Name = "Return if HP below",
	Description = "Return when HP is under this value",
	Flag = "ac_returnhp",
	Range = {1, 50},
	Increment = 1,
	CurrentValue = 20,
	Callback = function(v)
		S.returnHP = v
		if S.hp and S.hp >= v then S.hpArmed = true end
		logf("UI", "Return if HP < " .. v, true)
	end
})

Tab:CreateSection({Name = "Base"})

Tab:CreateButton({
	Name = "Set Base",
	Description = "Save current position as base",
	Interact = "Set",
	Callback = function()
		local hrp = getHRP()
		if hrp then
			S.base = hrp.Position
			notify("Base", "Base position saved")
		end
	end
})

Tab:CreateButton({
	Name = "Return to Base",
	Description = "Teleport to base",
	Interact = "Go",
	Callback = function()
		logf("UI", "Return to Base button", true)
		task.spawn(function()
			S.bagFull = true
			returnToBase()
		end)
	end
})

if not MobsMod then
	notify("Mobs", "Client.Mobs module cannot be required, using FxLocal.Mobs folder scan")
end
