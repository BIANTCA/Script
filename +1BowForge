local function addDrop(id, item, x, z, auto)
	if id == nil or x == nil or z == nil then return end
	if not drops[id] then
		drops[id] = {id = id, item = item, x = x, z = z, auto = auto, t = os.clock()}
		clearSince = nil
		dropSeen = true
		logf("Drop", string.format("Read drop #%s %s (%.0f, %.0f)%s", tostring(id), tostring(item), x, z, auto and " [auto]" or ""), true)
	end
end

local function removeDrop(id)
	if drops[id] ~= nil then
		logf("Drop", "Removed drop #" .. tostring(id))
	end
	drops[id] = nil
	asked[id] = nil
	skipLogged[id] = nil
end

