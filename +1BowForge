end

local function goStage(n, hrp)
	local inst = findStage(n)
	local pos = inst and stagePos(inst)
	if not pos then return false end
	setState(string.format("Going to Stage%02d", n))
	local tw, t = tweenTo(CFrame.new(pos + Vector3.new(0, S.stageLift, 0)), hrp)
	local t0 = os.clock()
	while running() and S.combat and not S.bagFull
		and os.clock() - t0 < t + 2
		and tw.PlaybackState == Enum.PlaybackState.Playing do
		task.wait(0.05)
	end
	logf("Stage", string.format("Arrived at Stage%02d", n), true)
	return true
end

local function advanceStage()
	emptyTries = 0
	cleared = false
	clearSince = nil
	dropSeen = false
	if stageIdx >= S.stageMax then
		stageDone = true
		setState("Finished: stage limit " .. stageIdx)
		notify("Stage", "Stage " .. stageIdx .. " finished (max limit)")
	else
		stageIdx = stageIdx + 1
		needTravel = true
		table.clear(drops)
		table.clear(asked)
		table.clear(skipLogged)
		setState("Next: Stage " .. stageIdx)
		notify("Stage", "Moving to Stage " .. stageIdx)
	end
end

