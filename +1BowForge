local function normRarity(sel)
	if type(sel) == "table" then
		if sel.CurrentOption ~= nil then sel = sel.CurrentOption
		elseif sel.Value ~= nil then sel = sel.Value
		elseif sel.value ~= nil then sel = sel.value end
	end
	local valid = {}
	for _, r in ipairs(rarityList) do valid[r] = true end
	if type(sel) == "table" then
		local t, n, total = {}, 0, 0
		local allBool = true
		for k, v in pairs(sel) do
			total = total + 1
			local name
			if type(k) == "number" then
				name = tostring(v)
				allBool = false
			elseif v then
				name = k
			end
			if type(k) ~= "number" and (type(v) ~= "boolean" or not valid[k]) then allBool = false end
			if name and valid[name] then
				t[name] = true
				n = n + 1
			end
		end
		if total > 0 and n == 0 and not allBool then return nil end
		return t
	elseif type(sel) == "string" and valid[sel] then
		return {[sel] = true}
	end
	return nil
end

local function readSavedFlag(flag)
	local v
	pcall(function()
		if Gui._savedFlags then v = Gui._savedFlags[flag] end
	end)
	if v ~= nil then return v end
	pcall(function()
		local path = "TumblrConfigs/autocombat.json"
		if isfile and readfile and isfile(path) then
			local data = game:GetService("HttpService"):JSONDecode(readfile(path))
			if type(data) == "table" then
				v = data[flag]
				if v == nil and type(data.Flags) == "table" then v = data.Flags[flag] end
				if v == nil and type(data.flags) == "table" then v = data.flags[flag] end
			end
		end
	end)
	return v
end

