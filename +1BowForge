local function fmtNum(n)
	n = tonumber(n) or 0
	if n >= 1e9 then return string.format("%.2fB", n / 1e9) end
	if n >= 1e6 then return string.format("%.2fM", n / 1e6) end
	if n >= 1e3 then return string.format("%.1fK", n / 1e3) end
	return tostring(math.floor(n))
end

local function enhanceReport()
	local prof = StateMod and StateMod.profile
	if not prof then return "Profile not loaded yet" end
	local enh = prof.enhance
	if type(enh) ~= "table" then return "No enhance data" end
	local rb = prof.rebirths or 0
	local feathers = prof.feathers or 0
	local coins = prof.coins or 0
	local mats = prof.materials or {}
	local dust = mats.StarDust or 0
	local core = mats.CometCore or 0
	local scrolls = prof.scrolls or 0
	local lines = {}

	local openAt = Economy and Economy.RebirthUnlocks and Economy.RebirthUnlocks.mira
	if openAt and rb < openAt then
		lines[#lines + 1] = "Enchant unlocks at Rebirth " .. openAt .. " (now " .. rb .. ")"
	end
	lines[#lines + 1] = "Feather " .. feathers .. " | Coins " .. fmtNum(coins)
		.. " | Star Dust " .. dust .. " | Comet Core " .. core .. " | Scroll " .. scrolls

	local maxLv = Enchant and Enchant.maxLevel and Enchant.maxLevel(rb) or nil
	for _, slot in ipairs({"bow", "quiver", "cloak"}) do
		local e = enh[slot]
		if type(e) == "table" then
			local lv = e.level or 0
			local cost = e.cost or {}
			local needF, needC = cost[1] or 0, cost[2] or 0
			local needD, needK = e.dust or 0, e.core or 0
			local chance = math.floor((e.chance or 0) * 100 + 0.5)
			local status
			if Enchant and Enchant.ENHANCE_MAX and lv >= Enchant.ENHANCE_MAX then
				status = "MAX"
			elseif maxLv and lv >= maxLv then
				local need = Enchant and Enchant.EnhanceOpens and Enchant.EnhanceOpens[lv + 1]
				status = need and ("locked, needs Rebirth " .. need) or "locked"
			else
				local miss = {}
				if feathers < needF then miss[#miss + 1] = "Feather " .. (needF - feathers) end
				if coins < needC then miss[#miss + 1] = "Coins " .. fmtNum(needC - coins) end
				if dust < needD then miss[#miss + 1] = "Dust " .. (needD - dust) end
				if core < needK then miss[#miss + 1] = "Core " .. (needK - core) end
				status = (#miss == 0) and "READY" or ("missing " .. table.concat(miss, ", "))
			end
			lines[#lines + 1] = string.format("%s +%d -> +%d | %d%% | F%d C%s D%d K%d | fails %d | %s",
				string.upper(slot), lv, lv + 1, chance, needF, fmtNum(needC), needD, needK, e.fails or 0, status)
		end
	end
	return table.concat(lines, "\n")
end

local function getMobFolder()
	local fx = (FxMod and FxMod.folder) or workspace:FindFirstChild("FxLocal")
	return fx and fx:FindFirstChild("Mobs")
end

local function rootOf(inst)
	if inst:IsA("BasePart") then return inst end
	if inst:IsA("Model") then
		return inst.PrimaryPart
			or inst:FindFirstChild("HumanoidRootPart")
			or inst:FindFirstChildWhichIsA("BasePart")
	end
end

local function listTargets(origin)
	local out = {}

	if MobsMod then
		local ok, list = pcall(MobsMod.targets, origin, S.range)
		if ok and type(list) == "table" then
			for _, m in ipairs(list) do
				local isBoss = m.def and m.def.boss
				if m.popped and not MobsMod.rising(m) and (S.boss or not isBoss) then
					out[#out + 1] = {ref = m, dist = m.dist or 0}
				end
			end
			return out
		end
	end

	local folder = getMobFolder()
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			if not child:IsA("Highlight") and not child:IsA("BillboardGui") then
				local r = rootOf(child)
				if r and math.abs(r.Position.Y - origin.Y) < 120 then
					local d = (Vector3.new(r.Position.X, 0, r.Position.Z) - Vector3.new(origin.X, 0, origin.Z)).Magnitude
					if d <= S.range then
						out[#out + 1] = {ref = child, dist = d, fallback = true}
					end
				end
			end
		end
		table.sort(out, function(a, b) return a.dist < b.dist end)
	end
	return out
end

local function targetValid(t)
	if not t then return false end
	if t.fallback then
		local r = t.ref.Parent and rootOf(t.ref)
		return r ~= nil and r.Position.Y > -100
	end
	local m = t.ref
	if MobsMod.get(m.id) ~= m then return false end
	if m.predHp <= 0 then return false end
	if State and m.state == State.Spawn then return false end
	return true
end

local function targetPos(t)
	if t.fallback then
		local r = rootOf(t.ref)
		return r.Position - Vector3.new(0, S.heightOffset - 3, 0)
	end
	return MobsMod.pos(t.ref)
end

local function aliveCount(origin)
	if MobsMod then
		local ok, n = pcall(MobsMod.count)
		if ok and type(n) == "number" then return n end
	end
	local folder = getMobFolder()
	local n = 0
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			if not child:IsA("Highlight") and not child:IsA("BillboardGui") then
				local r = rootOf(child)
				if r and math.abs(r.Position.Y - origin.Y) < 120 then n = n + 1 end
			end
		end
	end
	return n
end

local currentTween
local function cancelTween()
	if currentTween then currentTween:Cancel() currentTween = nil end
end

local function tweenTo(cf, hrp)
	cancelTween()
	local dist = (hrp.Position - cf.Position).Magnitude
	local t = math.max(dist / S.speed, 0.05)
	logf("Move", string.format("Tween %.0f studs (%.1fs)", dist, t))
	currentTween = TS:Create(hrp, TweenInfo.new(t, Enum.EasingStyle.Linear), {CFrame = cf})
	currentTween:Play()
	return currentTween, t
end

local function tpTo(cf, hrp)
	cancelTween()
	logf("Move", string.format("Instant teleport %.0f studs", (hrp.Position - cf.Position).Magnitude))
	hrp.CFrame = cf
	hrp.AssemblyLinearVelocity = Vector3.zero
end

local stageCache = {}

local function findStage(n)
	local c = stageCache[n]
	if c and c.Parent then return c end
	local name = string.format("Stage%02d", n)
	local cam = workspace.CurrentCamera
	for _, d in ipairs(workspace:GetDescendants()) do
		if d.Name == name
			and (d:IsA("Model") or d:IsA("BasePart") or d:IsA("Folder"))
			and not (cam and d:IsDescendantOf(cam)) then
			stageCache[n] = d
			logf("Stage", "Found " .. name)
			return d
		end
	end
	logf("Stage", name .. " not found")
	return nil
end

local function stagePos(inst)
