task.spawn(function()
	local lastTween, lastHomeCheck = 0, 0
	local wasActive = false

	while running() do
		task.wait()

		local active = S.combat or S.collect
		if not active then
			cancelTween()
			current = nil
			wasActive = false
			setState(S.train and "Auto Train active" or "Idle (Auto Combat & Auto Collect off)")
			continue
		end
		if not wasActive then
			wasActive = true
			logf("Main", "Loop active (combat=" .. tostring(S.combat) .. " collect=" .. tostring(S.collect) .. ")", true)
			resetStageTimers()
		end

		local hrp, hum = getHRP()
		if not (hrp and hum and hum.Health > 0) then
			current = nil
			setState("Waiting for character")
			continue
		end

		if S.bagFull then
			current = nil
			returnToBase("bag")
			resetStageTimers()
			continue
		end

		if S.returnOnFull and S.combat and S.hpArmed and S.hp and S.hp > 0
			and S.hp < S.returnHP and not S.returning then
			logf("HP", "HP " .. S.hp .. " < " .. S.returnHP .. ", returning to base", true)
			notify("Return", "HP " .. math.floor(S.hp) .. " below " .. S.returnHP .. ", returning to base")
			current = nil
			S.hpArmed = false
			returnToBase("hp")
			resetStageTimers()
			continue
		end

		local now = os.clock()
		local handled = false

		if S.combat and stageIdx and not stageBroken
			and not needTravel and now - lastHomeCheck > 0.3 then
			lastHomeCheck = now
			if nearHome(hrp.Position) then
				local inst = findStage(stageIdx)
				local sp = inst and stagePos(inst)
				if not sp or (sp - hrp.Position).Magnitude > S.homeRadius then
					current = nil
					cancelTween()
					resetStage()
					notify("Stage", "At base, starting from Stage " .. S.stageStart)
					continue
				end
			end
		end

		local stageActive = S.combat and not stageDone and not stageBroken

		if stageActive then
			if not stageIdx then
				stageIdx = math.clamp(S.stageStart, 1, 30)
				needTravel = true
				logf("Stage", "Starting from Stage " .. stageIdx, true)
			end
			if needTravel then
				needTravel = false
				current = nil
				if goStage(stageIdx, hrp) then
					resetStageTimers()
				else
					stageBroken = true
					setState(string.format("Error: Stage%02d not found", stageIdx))
					notify("Stage", string.format("Stage%02d not found in Workspace, Auto Stage skipped", stageIdx))
				end
				continue
			end
		end

		local collectOn = S.collect

		local mobsNow = nil
		if stageActive then
			mobsNow = aliveCount(hrp.Position)
			if mobsNow ~= mobCount then
				logf("Mob", "Mob count: " .. mobCount .. " -> " .. mobsNow, true)
				mobCount = mobsNow
			end
			if mobsNow > 0 then
				seenMob = true
				if cleared then
					local pc = collectOn and pendingCount(hrp) or 0
					if pc == 0 then
						logf("Mob", "Mobs respawned (" .. mobsNow .. ") & all drops checked, next stage", true)
						advanceStage()
						continue
					end
				else
					emptySince = nil
					clearSince = nil
					lastCollectTP = now
				end
			elseif seenMob and not emptySince then
				emptySince = now
				logf("Mob", "Mobs = 0, detecting drops", true)
			end
		end

		local idleElapsed = 0
		if stageActive and seenMob and emptySince then
			idleElapsed = now - math.max(emptySince, lastCollectTP)
		end

		if collectOn and (mobsNow == nil or mobsNow == 0 or cleared) then
			local d, mode = nearestDrop(hrp)
			if d then
				current = nil
				if stageActive and seenMob and emptySince then
					cleared = true
				end
				if stageActive and seenMob and emptySince
					and now - math.max(emptySince, lastCollectTP) >= S.collectIdle then
					notify("Collect", "No teleport for " .. S.collectIdle .. "s, forcing next stage")
					advanceStage()
				else
					collectDrop(d, mode, hrp)
				end
				handled = true
			end
		end

		if not handled and stageActive then
			if mobsNow > 0 then
				if cleared then
					setState(string.format("Mobs back (%d), waiting for Auto Collect", mobsNow))
				else
					setState(string.format("Killing mobs in Stage%02d (mobs: %d)", stageIdx, mobsNow))
				end
			elseif seenMob then
				if not collectOn then
					logf("Stage", "Mobs = 0 & Auto Collect off, next stage", true)
					advanceStage()
					continue
				elseif not cleared and emptySince and now - emptySince < S.clearDelay then
					setState("Mobs = 0, checking drops")
				else
					local pc = pendingCount(hrp)
					if pc > 0 then
						cleared = true
						clearSince = nil
						if idleElapsed >= S.collectIdle then
							notify("Collect", "No teleport for " .. S.collectIdle .. "s, forcing next stage")
							advanceStage()
							continue
						end
						setState("Drops = " .. pc .. ", Auto Collect running")
					elseif dropSeen then
						logf("Collect", "All drops checked, next stage", true)
						advanceStage()
						continue
					elseif now - (emptySince or now) < S.lootGrace then
						setState("Mobs = 0, waiting for drops")
					else
						clearSince = clearSince or now
						if now - clearSince >= S.collectConfirm then
							logf("Collect", "Drops = 0 confirmed, next stage", true)
							advanceStage()
							continue
						else
							setState("Drops = 0, confirming Auto Collect")
						end
					end
				end
			elseif now - enteredAt > S.startTimeout then
				local pc = collectOn and pendingCount(hrp) or 0
				if pc == 0 then
					emptyTries = emptyTries + 1
					logf("Stage", "No mobs appeared (attempt " .. emptyTries .. "/2)", true)
					if emptyTries >= 2 then
						notify("Stage", "Stage " .. stageIdx .. " has no mobs, skipped")
						advanceStage()
					else
						needTravel = true
					end
					continue
				end
			else
				setState("Waiting for mobs to spawn")
			end
		end

		if not handled and S.combat then
			if not targetValid(current) then
				current = listTargets(hrp.Position)[1]
				if current then
					local nm = (current.fallback and tostring(current.ref.Name))
						or (current.ref.def and tostring(current.ref.def.name or current.ref.def.id))
						or "mob"
					logf("Combat", "New target: " .. nm)
				end
			end

			if current then
				local pos = targetPos(current)
				local dir = Vector3.new(hrp.Position.X - pos.X, 0, hrp.Position.Z - pos.Z)
				if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, 1) end
				local flat = pos + dir.Unit * S.distance
				local stand = Vector3.new(flat.X, pos.Y + S.heightOffset, flat.Z)
				local look = Vector3.new(pos.X, stand.Y, pos.Z)

				if (hrp.Position - stand).Magnitude > 80 then
					if now - lastTween > 0.3 then
						lastTween = now
						tweenTo(CFrame.lookAt(stand, look), hrp)
					end
				else
					cancelTween()
					hrp.CFrame = CFrame.lookAt(stand, look)
					hrp.AssemblyLinearVelocity = Vector3.zero
				end
			else
				cancelTween()
			end
		end
	end
end)

