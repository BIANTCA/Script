local function findTrainPad(r)
	if r.pad and r.pad.Parent then return r.pad end
	local lobby = workspace:FindFirstChild("SkyIslesLobby_Redesign")
	if not lobby then return nil end
	local model = lobby:FindFirstChild(r.model) or lobby:FindFirstChild(r.model, true)
	if not model then return nil end
	local pad = model:FindFirstChild(r.model .. "_Pad__Color")
		or model:FindFirstChild(r.model .. "_Pad_Color")
	if not pad then
		for _, d in ipairs(model:GetDescendants()) do
			if d.Name:find("Pad", 1, true) and d.Name:find("Color", 1, true) then
				pad = d
				break
			end
		end
	end
	r.pad = pad
	return pad
end

