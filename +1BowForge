local function rawNotify(title, content, dur)
	pcall(function()
		Gui:Notify({Title = title, Content = content, Duration = dur or 3})
	end)
end

local function notify(key, title, content, dur)
	logf("Notify", "[" .. key .. "] " .. title .. ": " .. content)
	if muteAll or muted[key] then return end
	local sig = key .. "|" .. title .. "|" .. content
	local now = os.clock()
	if lastNotif[sig] and now - lastNotif[sig] < 2 then return end
	lastNotif[sig] = now
	rawNotify(title, content, dur)
end

local function uiNotify(key, title, content)
	if uiReady then notify(key, title, content, 2) end
end

local function uiNotifyD(id, key, title, content)
	if not uiReady then return end
	uiDebounce[id] = (uiDebounce[id] or 0) + 1
	local n = uiDebounce[id]
	task.delay(0.6, function()
		if uiDebounce[id] == n and running() then
			notify(key, title, content, 2)
		end
	end)
end

