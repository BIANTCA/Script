local function logf(tag, msg, force)
	local key = tag .. "|" .. msg
	local now = os.clock()
	if not force and lastLog[key] and now - lastLog[key] < 1.5 then return end
	lastLog[key] = now
	local line = string.format("[%s][%s] %s", os.date("%H:%M:%S"), tag, msg)
	print("[AutoCombat]" .. line)
	table.insert(logLines, line)
	if #logLines > 6 then table.remove(logLines, 1) end
end

local function setState(txt)
	if txt ~= stateText then
