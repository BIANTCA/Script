		forgeStatus = "Forge failed or no result"
		logf("Forge", "No AltarResult (rejected or timeout)", true)
		notify("Forge", "Forge", "Forge failed or no result from server", 2)
		task.wait(1)
	end

	if backCF then
		local h2 = getHRP()
		if h2 then
			h2.CFrame = backCF
			h2.AssemblyLinearVelocity = Vector3.zero
		end
	end
	forging = false
