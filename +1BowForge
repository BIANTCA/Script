task.spawn(function()
	local lastAttempt = 0
	local doneNotified = false

	while running() do
		task.wait(0.2)

		if not S.enhance then
			enhanceStatus = "Off"
			doneNotified = false
			continue
		end

		local prof = StateMod and StateMod.profile
		if not (prof and type(prof.enhance) == "table") then
			enhanceStatus = "Waiting for profile data"
			continue
		end

		local now = os.clock()
		if now - lastAttempt < S.enhanceDelay then continue end

		local rb = prof.rebirths or 0
		local openAt = Economy and Economy.RebirthUnlocks and Economy.RebirthUnlocks.mira
		if openAt and rb < openAt then
			enhanceStatus = "Enchant unlocks at Rebirth " .. openAt
			continue
		end

		local cap = math.min(S.enhanceTarget, enhMaxLevel(rb))
		local mats = prof.materials or {}
		local feathers, coins = prof.feathers or 0, prof.coins or 0
		local dust, core = mats.StarDust or 0, mats.CometCore or 0
		local scrolls = prof.scrolls or 0

		local picked
		local notes = {}
		local reachedTarget, selected = 0, 0
		for _, slot in ipairs(enhSlotOrder) do
			if S.enhSlots[slot] then
				selected = selected + 1
				local e = prof.enhance[slot]
				local cost = type(e) == "table" and e.cost or {}
				if type(e) ~= "table" or e.uid == nil then
					notes[#notes + 1] = slot .. ": empty"
				elseif (enhBlocked[slot] or 0) > now then
					notes[#notes + 1] = slot .. ": on hold"
				elseif (e.level or 0) >= cap then
					reachedTarget = reachedTarget + 1
					notes[#notes + 1] = slot .. ": +" .. (e.level or 0) .. " (target " .. cap .. ")"
				elseif feathers < (cost[1] or 0) then
					notes[#notes + 1] = slot .. ": need Feather"
				elseif coins < (cost[2] or 0) then
					notes[#notes + 1] = slot .. ": need Coins"
				elseif dust < (e.dust or 0) then
					notes[#notes + 1] = slot .. ": need Star Dust"
				elseif core < (e.core or 0) then
					notes[#notes + 1] = slot .. ": need Comet Core"
				else
					picked = slot
					break
				end
			end
		end

		if not picked then
			enhanceStatus = #notes > 0 and table.concat(notes, " | ") or "Select a slot to enhance"
			if selected > 0 and reachedTarget == selected and not doneNotified then
				doneNotified = true
				notify("Enhance", "Enhance", "All selected slots reached target +" .. cap)
			end
			continue
		end
		doneNotified = false

		local e = prof.enhance[picked]
		local chance = e.chance or 1
		local useScroll = S.enhanceScroll and now >= scrollBlockedUntil and scrolls > 0
			and chance < 1 and chance * 100 <= S.scrollBelow
		lastAttempt = now
		enhanceStatus = string.format("Enhancing %s +%d -> +%d (%d%%)%s",
			picked, e.level or 0, (e.level or 0) + 1, math.floor(chance * 100 + 0.5), useScroll and " + scroll" or "")

		local before = enhStamp
		fireCmd("Enhance", e.uid, useScroll and true or false)
		local t0 = os.clock()
		while enhStamp == before and os.clock() - t0 < 3 and running() do
			task.wait(0.05)
		end

		if enhStamp == before then
			enhBlocked[picked] = os.clock() + 3
			logf("Enhance", "No Enhanced reply from server", true)
			notify("Enhance", "Enhance", picked .. ": no reply from server")
		else
			local r = lastEnhanced
			if type(r) == "table" then
				if r.ok then
					logf("Enhance", string.format("%s +%s -> +%s %s%s", picked, tostring(r.from), tostring(r.level),
						r.success and "SUCCESS" or "FAILED", r.scroll and " (scroll)" or ""), true)
					notify("Enhance", r.success and "Enhance Success" or "Enhance Failed",
						string.format("%s +%s -> +%s%s", string.upper(picked), tostring(r.from), tostring(r.level),
							r.scroll and " (scroll used)" or ""), 2)
				else
					logf("Enhance", picked .. " rejected: " .. tostring(r.why), true)
					notify("Enhance", "Enhance Rejected", picked .. ": " .. tostring(r.why), 2)
					if r.why == "scroll" then
						scrollBlockedUntil = os.clock() + 30
					else
						enhBlocked[picked] = os.clock() + 5
					end
				end
			end
		end

		local pb = profStamp
		local t1 = os.clock()
		while profStamp == pb and os.clock() - t1 < 0.4 and running() do
			task.wait(0.05)
		end
		if profStamp == pb then
			fireCmd("Profile")
			t1 = os.clock()
			while profStamp == pb and os.clock() - t1 < 1.2 and running() do
				task.wait(0.05)
			end
		end
		task.wait(0.15)
	end
end)

-- Auto Forge: Cmd AltarOpen -> AltarAdd -> AltarCraft/AltarArmour (slots, nil, nil) -> event AltarResult -> Cmd AltarChoose (uid, equip|sell|keep)
local function waitStamp(getter, before, timeout)
	local t0 = os.clock()
	while getter() == before and os.clock() - t0 < timeout and running() do
		task.wait(0.05)
	end
	return getter() ~= before
end

local function forgeBenchCF()
	local bench = workspace:FindFirstChild("CraftingBench")
	if not (bench and bench:IsA("Model")) then return nil end
	local stance = bench:FindFirstChild("Stance")
	if stance and stance:IsA("BasePart") then
		return CFrame.new(stance.Position - Vector3.new(0, stance.Size.Y / 2, 0) + Vector3.new(0, 3, 0))
	end
	return bench:GetPivot() * CFrame.new(3.8, 3.6, 3.9)
end

local function forgePickSlots(storage, want)
	local slots
	if Craft and type(Craft.bestFill) == "function" then
		local ok, res = pcall(Craft.bestFill, storage, want)
		if ok and type(res) == "table" and #res > 0 then slots = res end
	end
	if slots then return slots end
	local list = {}
	for id, n in pairs(storage) do
		if Craft and Craft.Essences and Craft.Essences[id] and n > 0 then
			list[#list + 1] = {id = id, n = n}
		end
	end
	table.sort(list, function(a, b) return a.n > b.n end)
	slots = {}
	local left = want
	local maxKinds = (Craft and tonumber(Craft.SLOTS)) or 4
	for _, e in ipairs(list) do
		if left <= 0 or #slots >= maxKinds then break end
		local take = math.min(e.n, left)
		slots[#slots + 1] = {id = e.id, n = take}
		left = left - take
	end
	if left > 0 then return nil end
	return slots
end

local function forgeStep()
	if not S.autoForge then
		forgeStatus = "Off"
		return
	end
	if S.returning or S.bagFull then
		forgeStatus = "Paused (returning)"
		return
	end
	if not Cmd then
		forgeStatus = "Cmd remote not found"
		return
	end
	if not Craft then
		forgeStatus = "Craft module not found"
		return
	end
	local hrp, hum = getHRP()
	if not (hrp and hum and hum.Health > 0) then
		forgeStatus = "Waiting for character"
		return
	end

	local isArmour = S.forgeType == "Armour"

	local b = forgeStateStamp
	Cmd:FireServer("AltarOpen")
	if not waitStamp(function() return forgeStateStamp end, b, 3) then
		forgeStatus = "No reply from server (AltarOpen)"
		return
	end

	local storage = forgeStorage
	if type(storage) ~= "table" then
		forgeStatus = "Storage not loaded"
		return
	end
	if isArmour and Craft.ASK_PIECE and (storage[Craft.ASK_PIECE] or 0) > 0 then
		storage = table.clone(storage)
		storage[Craft.ASK_PIECE] = nil
	end

	local total = 0
	for id, n in pairs(storage) do
		if Craft.Essences and Craft.Essences[id] then total = total + n end
	end
	local want = math.clamp(S.forgeLoot, forgeMinLoot, forgeMaxLoot)
	if total < want then
		forgeStatus = "Waiting for loot (" .. total .. "/" .. want .. ")"
		return
	end

	local slots = forgePickSlots(storage, want)
	if not slots then
		forgeStatus = "Cannot build loot set"
		return
	end

	forging = true
	cancelTween()
	current = nil
	local backCF
	if S.forgeTeleport then
		local cf = forgeBenchCF()
		if cf then
			backCF = hrp.CFrame
			forgeStatus = "Teleporting to Crafting Bench"
			tpTo(cf, hrp)
			task.wait(0.4)
		end
	end

	forgeStatus = "Forging (" .. S.forgeType .. ", " .. want .. " Loot)"
	local b2 = forgeStateStamp
	Cmd:FireServer("AltarOpen")
	waitStamp(function() return forgeStateStamp end, b2, 3)
	Cmd:FireServer("AltarAdd")
	task.wait(0.1)

	forgeResult = nil
	local rb = forgeResultStamp
	Cmd:FireServer(isArmour and "AltarArmour" or "AltarCraft", slots, nil, nil)
	local got = waitStamp(function() return forgeResultStamp end, rb, 10)
	local r = forgeResult
	local rec = r and (r.bow or r.armour)

	if got and rec and rec.uid ~= nil then
		local better
		if isArmour or r.armour then
			local cur = forgeWorn and rec.slot and forgeWorn[rec.slot]
			if not cur then
				better = true
			elseif Craft.armourValue then
				local okA, a = pcall(Craft.armourValue, rec)
				local okB, c = pcall(Craft.armourValue, cur)
				better = okA and okB and a > c
			end
		else
			better = forgeEquipped == nil or (tonumber(rec.power) or 0) > (tonumber(forgeEquipped.power) or 0)
		end
		local choice = better and "equip" or (S.forgeWorse == "Sell" and "sell" or "keep")
		local cb = forgeChosenStamp
