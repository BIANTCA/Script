local RS = game:GetService("ReplicatedStorage")
local TS = game:GetService("TweenService")

local lp = Players.LocalPlayer
local env = (getgenv and getgenv()) or _G

-- Guard re-execute
local runId = {}
env.__AC_RUN = runId
local function running() return env.__AC_RUN == runId end
if env.__AC_CONNS then
	for _, c in ipairs(env.__AC_CONNS) do pcall(function() c:Disconnect() end) end
end
env.__AC_CONNS = {}

----------------------------------------------------------------
-- LOG + STATE
----------------------------------------------------------------
local logLines = {}
local stateText = "Idle"
local lastLog = {}

local function logf(tag, msg, force)
	local key = tag .. "|" .. msg
	local now = os.clock()
	if not force and lastLog[key] and now - lastLog[key] < 1.5 then return end
	lastLog[key] = now
	local line = string.format("[%s][%s] %s", os.date("%H:%M:%S"), tag, msg)
	print("[AutoCombat]" .. line)
	table.insert(logLines, line)
	if #logLines > 6 then table.remove(logLines, 1) end
end

local function setState(txt)
	if txt ~= stateText then
		stateText = txt
		logf("State", txt, true)
	end
end

