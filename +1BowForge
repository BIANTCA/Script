----------------------------------------------------------------
-- Mob targeting
----------------------------------------------------------------
local function getMobFolder()
	local fx = (FxMod and FxMod.folder) or workspace:FindFirstChild("FxLocal")
	return fx and fx:FindFirstChild("Mobs")
end

local function rootOf(inst)
	if inst:IsA("BasePart") then return inst end
	if inst:IsA("Model") then
		return inst.PrimaryPart
			or inst:FindFirstChild("HumanoidRootPart")
			or inst:FindFirstChildWhichIsA("BasePart")
	end
end

local function listTargets(origin)
	local out = {}

	if MobsMod then
		local ok, list = pcall(MobsMod.targets, origin, S.range)
		if ok and type(list) == "table" then
			for _, m in ipairs(list) do
				local isBoss = m.def and m.def.boss
				if m.popped and not MobsMod.rising(m) and (S.boss or not isBoss) then
					out[#out + 1] = {ref = m, dist = m.dist or 0}
				end
			end
			return out
		end
	end

	local folder = getMobFolder()
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			if not child:IsA("Highlight") and not child:IsA("BillboardGui") then
				local r = rootOf(child)
				if r and math.abs(r.Position.Y - origin.Y) < 120 then
					local d = (Vector3.new(r.Position.X, 0, r.Position.Z) - Vector3.new(origin.X, 0, origin.Z)).Magnitude
					if d <= S.range then
						out[#out + 1] = {ref = child, dist = d, fallback = true}
					end
				end
			end
		end
		table.sort(out, function(a, b) return a.dist < b.dist end)
	end
	return out
end

local function targetValid(t)
	if not t then return false end
	if t.fallback then
		local r = t.ref.Parent and rootOf(t.ref)
		return r ~= nil and r.Position.Y > -100
	end
	local m = t.ref
	if MobsMod.get(m.id) ~= m then return false end
	if m.predHp <= 0 then return false end
	if State and m.state == State.Spawn then return false end
	return true
end

local function targetPos(t)
	if t.fallback then
		local r = rootOf(t.ref)
		return r.Position - Vector3.new(0, S.heightOffset - 3, 0)
	end
	return MobsMod.pos(t.ref)
end

local function aliveCount(origin)
	if MobsMod then
		local ok, n = pcall(MobsMod.count)
		if ok and type(n) == "number" then return n end
	end
	local folder = getMobFolder()
	local n = 0
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			if not child:IsA("Highlight") and not child:IsA("BillboardGui") then
				local r = rootOf(child)
				if r and math.abs(r.Position.Y - origin.Y) < 120 then n = n + 1 end
			end
		end
	end
	return n
end

----------------------------------------------------------------
-- Movement
----------------------------------------------------------------
local currentTween
local function cancelTween()
	if currentTween then currentTween:Cancel() currentTween = nil end
end

-- Tween: hanya untuk Auto Combat (menuju stage & mendekati mob)
local function tweenTo(cf, hrp)
	cancelTween()
	local dist = (hrp.Position - cf.Position).Magnitude
	local t = math.max(dist / S.speed, 0.05)
	logf("Move", string.format("Tween %.0f studs (%.1fs)", dist, t))
	currentTween = TS:Create(hrp, TweenInfo.new(t, Enum.EasingStyle.Linear), {CFrame = cf})
	currentTween:Play()
	return currentTween, t
end

-- Teleport instant: untuk Auto Collect & Kembali ke Base
local function tpTo(cf, hrp)
	cancelTween()
	logf("Move", string.format("Teleport instant %.0f studs", (hrp.Position - cf.Position).Magnitude))
	hrp.CFrame = cf
	hrp.AssemblyLinearVelocity = Vector3.zero
end

----------------------------------------------------------------
-- Stage lookup (Workspace ... StageXX)
----------------------------------------------------------------
local stageCache = {}

local function findStage(n)
	local c = stageCache[n]
	if c and c.Parent then return c end
	local name = string.format("Stage%02d", n)
	local cam = workspace.CurrentCamera
	for _, d in ipairs(workspace:GetDescendants()) do
		if d.Name == name
			and (d:IsA("Model") or d:IsA("BasePart") or d:IsA("Folder"))
			and not (cam and d:IsDescendantOf(cam)) then
			stageCache[n] = d
			logf("Stage", "Ditemukan " .. name)
			return d
		end
	end
	logf("Stage", name .. " tidak ditemukan")
	return nil
end

local function stagePos(inst)
	if inst:IsA("BasePart") then return inst.Position end
	if inst:IsA("Model") then return inst:GetPivot().Position end
	local r = inst:FindFirstChildWhichIsA("BasePart", true)
	return r and r.Position
end

----------------------------------------------------------------
-- Bag / Base / Drops
----------------------------------------------------------------
local needTravel = false
local resetStage

local drops, asked = {}, {}
local skipLogged = {}
local bagList, bagSize = {}, 0
local lastCollectTP = os.clock()
local clearSince = nil
do
	local prof = StateMod and StateMod.profile
	if prof then
		bagList = prof.bag or {}
		bagSize = prof.bagSize or 0
	end
end

local function countDrops()
	local n = 0
	for _ in pairs(drops) do n = n + 1 end
	return n
end

local function addDrop(id, item, x, z, auto)
	if id == nil or x == nil or z == nil then return end
	if not drops[id] then
		drops[id] = {id = id, item = item, x = x, z = z, auto = auto, t = os.clock()}
		clearSince = nil
		logf("Drop", string.format("Baca drop #%s %s (%.0f, %.0f)%s", tostring(id), tostring(item), x, z, auto and " [auto]" or ""), true)
	end
end

local function removeDrop(id)
	if drops[id] ~= nil then
		logf("Drop", "Hapus drop #" .. tostring(id))
	end
	drops[id] = nil
	asked[id] = nil
	skipLogged[id] = nil
end

if Net and Net.Evt then
	local c = Net.Evt.OnClientEvent:Connect(function(name, data)
		if name == "StageLoot" and type(data) == "table" and data.drops then
			logf("Event", "StageLoot: " .. #data.drops .. " drop masuk", true)
			for _, d in ipairs(data.drops) do addDrop(d[1], d[2], d[3], d[4]) end
		elseif name == "Drop" and type(data) == "table" then
			local p = data.pos
			local x = data.x or (p and p.X)
			local z = data.z
			if z == nil and p then
				z = (typeof(p) == "Vector2") and p.Y or p.Z
			end
			logf("Event", "Drop: " .. tostring(data.item or data.kind), true)
			addDrop(data.id, data.item or data.kind, x, z, true)
		elseif name == "Picked" and type(data) == "table" then
			logf("Event", "Picked #" .. tostring(data.id))
			removeDrop(data.id)
		elseif name == "LootGone" and type(data) == "table" and data.ids then
			logf("Event", "LootGone: " .. #data.ids .. " drop hilang")
			for _, id in ipairs(data.ids) do removeDrop(id) end
		elseif name == "Collected" and type(data) == "table" then
			if data.bag then bagList = data.bag end
			if data.bagSize then bagSize = data.bagSize end
			logf("Event", "Collected result=" .. tostring(data.result) .. " id=" .. tostring(data.id))
			if data.result == "full" then
				if S.returnOnFull then S.bagFull = true end
			elseif data.id then
				removeDrop(data.id)
			end
		elseif name == "Profile" and type(data) == "table" then
			if data.bag then bagList = data.bag end
			if data.bagSize then bagSize = data.bagSize end
			logf("Event", "Profile update bag " .. #bagList .. "/" .. bagSize)
		elseif name == "BagFull" then
			logf("Event", "BagFull", true)
			if S.returnOnFull then S.bagFull = true end
		elseif name == "Banked" then
			logf("Event", "Banked: bag dikosongkan", true)
			bagList = {}
			S.bagFull = false
			S.returning = false
		elseif name == "Room" then
			logf("Event", "Room: reset semua drop", true)
			S.bagFull = false
			S.returning = false
			table.clear(drops)
			table.clear(asked)
			table.clear(skipLogged)
		end
	end)
	table.insert(env.__AC_CONNS, c)
else
	logf("Init", "Net.Evt tidak ditemukan, drop hanya dari sinkron client", true)
end

-- Return ke base: teleport INSTANT, lalu ulang semuanya dari Stage 1
local function returnToBase()
	if S.returning then return end
	S.returning = true
	setState("Return ke base (teleport instant)")
	cancelTween()
	local hrp = getHRP()
	if hrp and S.base then
		tpTo(CFrame.new(S.base), hrp)
		task.wait(0.1)
	end
	if S.useWarp then fireCmd("Warp", 0) end
	local t0 = os.clock()
	while S.bagFull and os.clock() - t0 < 6 and running() do
		task.wait(0.2)
	end
	S.bagFull = false
	S.returning = false
	if S.useWarp then
		task.wait(1)
		local h = getHRP()
		if h then S.camp = h.Position end
	end
	logf("Base", "Return selesai", true)
	if resetStage then resetStage() end
end

----------------------------------------------------------------
-- Collect (event StageLoot/Drop + Cmd "Collect", id, swap)
----------------------------------------------------------------
local pickupRange = (LootShared and LootShared.Tuning and LootShared.Tuning.pickupRange) or 9
local dropLife = (LootShared and LootShared.Tuning and LootShared.Tuning.dropLife) or 60

local function takeMode(d)
	if d.auto then return "auto" end
	local def = Craft and Craft.Essences and Craft.Essences[d.item]
	if not def then return "collect" end
	if S.rarity[def.rarity] ~= true then
		if not skipLogged[d.id] then
			skipLogged[d.id] = true
			logf("Drop", "Skip #" .. tostring(d.id) .. " " .. tostring(d.item) .. " (rarity " .. tostring(def.rarity) .. " tidak dipilih)", true)
		end
		return nil
	end
	if bagSize == 0 or #bagList < bagSize then return "collect" end
	local idx = LootShared and LootShared.lowest and LootShared.lowest(bagList)
	local low = idx and bagList[idx]
	if low and Craft.essenceSell and Craft.essenceSell(d.item) > Craft.essenceSell(low) then
		return "swap"
	end
	return nil, true
end

local function groundY(x, z, hrp)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {lp.Character, workspace:FindFirstChild("FxLocal")}
	local res = workspace:Raycast(Vector3.new(x, hrp.Position.Y + 8, z), Vector3.new(0, -60, 0), params)
	return res and res.Position.Y or (hrp.Position.Y - 3)
end

local lastSync = 0
local function syncFromClient(hrp)
	if not LootClient or os.clock() - lastSync < 0.5 then return end
	lastSync = os.clock()
	local ok, rec = pcall(LootClient.nearest, hrp.Position, S.collectRange)
	if ok and type(rec) == "table" and rec.id and rec.pos and not drops[rec.id] then
		logf("Sync", "Drop dari client Loot.nearest: #" .. tostring(rec.id))
		addDrop(rec.id, rec.item, rec.pos.X, rec.pos.Z)
	end
end

local function nearestDrop(hrp)
	syncFromClient(hrp)
	local now = os.clock()
	local best, bestMode, bd = nil, nil, S.collectRange
	local blocked = false
	for id, d in pairs(drops) do
		if now - d.t > dropLife then
			logf("Drop", "Drop #" .. tostring(id) .. " kedaluwarsa")
			removeDrop(id)
		elseif now - d.t >= 0.6 and (asked[id] or 0) < 3 then
			local mode, full = takeMode(d)
			if mode then
				local dist = (Vector3.new(d.x, 0, d.z) - Vector3.new(hrp.Position.X, 0, hrp.Position.Z)).Magnitude
				if dist < bd then best, bestMode, bd = d, mode, dist end
			elseif full then
				blocked = true
			end
		end
	end
	if not best and blocked and S.returnOnFull and not S.returning then
		logf("Bag", "Bag penuh & loot bagus tidak bisa ditukar -> return", true)
		S.bagFull = true
	end
	return best, bestMode
end

-- jumlah drop yang masih bisa/akan diambil (sesuai rarity, dalam jarak collect)
local function pendingCount(hrp)
	syncFromClient(hrp)
	local now = os.clock()
	local n = 0
	for id, d in pairs(drops) do
		if now - d.t > dropLife then
			removeDrop(id)
		elseif (asked[id] or 0) < 3 then
			local dist = (Vector3.new(d.x, 0, d.z) - Vector3.new(hrp.Position.X, 0, hrp.Position.Z)).Magnitude
			if dist <= S.collectRange and takeMode(d) then
				n = n + 1
			end
		end
	end
	return n
end

-- Auto Collect: teleport INSTANT ke drop
local function collectDrop(d, mode, hrp)
	clearSince = nil
	setState("Collecting: " .. tostring(d.item) .. " [" .. mode .. "]")
	logf("Collect", "Ambil #" .. tostring(d.id) .. " " .. tostring(d.item) .. " mode=" .. mode)
	local stand = Vector3.new(d.x, groundY(d.x, d.z, hrp) + 3, d.z)
	local flat = (Vector3.new(d.x, 0, d.z) - Vector3.new(hrp.Position.X, 0, hrp.Position.Z)).Magnitude
	local reach = d.auto and 4 or (pickupRange - 4)
	if flat > reach or math.abs(hrp.Position.Y - stand.Y) > 8 then
		tpTo(CFrame.new(stand), hrp)
		lastCollectTP = os.clock()
		task.wait(0.1)
	end
	if not drops[d.id] then
		logf("Collect", "Drop #" .. tostring(d.id) .. " sudah hilang")
		return
	end
	asked[d.id] = (asked[d.id] or 0) + 1
	if mode == "auto" then
		task.wait(0.5)
	else
		fireCmd("Collect", d.id, mode == "swap")
		task.wait(0.35)
	end
end

----------------------------------------------------------------
-- Stage state
----------------------------------------------------------------
local stageIdx = nil
local stageDone = false
local stageBroken = false
local enteredAt, seenMob, emptySince, emptyTries = 0, false, nil, 0
local mobCount = 0
local cleared = false
local waitSince = 0

local function resetStageTimers()
	enteredAt = os.clock()
	seenMob = false
	emptySince = nil
	lastCollectTP = os.clock()
	clearSince = nil
	cleared = false
	waitSince = 0
end

resetStage = function()
	logf("Stage", "Reset stage", true)
	stageIdx = nil
	stageDone = false
	stageBroken = false
	emptyTries = 0
	needTravel = true
	resetStageTimers()
end

-- Menuju stage: TWEEN (bagian Auto Combat)
local function goStage(n, hrp)
	local inst = findStage(n)
	local pos = inst and stagePos(inst)
	if not pos then return false end
	setState(string.format("Menuju Stage%02d", n))
	local tw, t = tweenTo(CFrame.new(pos + Vector3.new(0, S.stageLift, 0)), hrp)
	local t0 = os.clock()
	while running() and S.combat and not S.bagFull
		and os.clock() - t0 < t + 2
		and tw.PlaybackState == Enum.PlaybackState.Playing do
		task.wait(0.05)
	end
	logf("Stage", string.format("Tiba di Stage%02d", n), true)
	return true
end

local function advanceStage()
	emptyTries = 0
	cleared = false
	waitSince = 0
	clearSince = nil
	if stageIdx >= S.stageMax then
		stageDone = true
		setState("Selesai: batas stage " .. stageIdx)
		notify("Stage", "Stage " .. stageIdx .. " selesai (batas maksimal)")
	else
		stageIdx = stageIdx + 1
		needTravel = true
		-- Drop sisa stage sebelumnya dibuang bila stage baru belum/baru mulai Auto Collect
		if stageIdx <= S.collectFrom then
			table.clear(drops)
			table.clear(asked)
			table.clear(skipLogged)
		end
		setState("Lanjut ke Stage " .. stageIdx)
		notify("Stage", "Lanjut ke Stage " .. stageIdx)
	end
end

