local function pickTrainRange()
	local prof = StateMod and StateMod.profile
	local rb = prof and prof.rebirths
	if rb == nil then return nil, nil end
	local best
	for _, r in ipairs(trainRanges) do
		if rb >= r.min and (not best or r.min > best.min) then best = r end
	end
	return best, rb
